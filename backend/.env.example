# ==============================================================================
# NiK Trade Desk - Environment Variables Example
# DO NOT COMMIT REAL CREDENTIALS. Copy this file to .env and configure.
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=change-this-in-production-use-a-strong-secret-key-32chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL by default, falls back to SQLite if USE_SQLITE=True)
USE_SQLITE=False
DB_NAME=nik_tradedesk_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Angel One SmartAPI Official Credentials
# Obtain these from: https://smartapi.angelone.in/
ANGEL_API_KEY=your_angel_one_api_key_here
ANGEL_CLIENT_CODE=your_client_code_here
ANGEL_PIN=your_4_digit_mpin_here
ANGEL_TOTP_SECRET=your_base32_totp_secret_here

# Feed & Simulation Settings
SIMULATION_MODE_WHEN_DISCONNECTED=True
LOG_LEVEL=INFO
